# Copy this file to .env and fill in real values. .env is gitignored (safe for secrets).
# Real environment variables still override values here.
#
# Most config now lives in twinkle/resources/config.yaml (edit that file for
# tunables: agent.max_steps, context_compression, skills.mode/enabled,
# permissions policy). Only secrets + deploy-variable paths/endpoints/ports
# stay as env vars here, resolved into the YAML via ${ENV:-default}.

TWINKLE_LLM_BASE_URL=https://api.openai.com/v1
TWINKLE_LLM_API_KEY=
TWINKLE_LLM_MODEL=gpt-4o-mini

# Optional: override ports / workspace (defaults shown)
# TWINKLE_AGENTSERVER_PORT=18000
# TWINKLE_GATEWAY_PORT=19000
# TWINKLE_WORKSPACE_DIR=~/.twinkle

# --- observability (OTel, agentserver-only; default off = zero-cost no-op) ---
# OTEL_* stays in twinkle/observability/config.py (not folded into config.yaml, v1).
# OTEL_ENABLED=true
# OTEL_TRACES_EXPORTER=otlp
# OTEL_METRICS_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://101.37.215.110:4317
# OTEL_SERVICE_NAME=twinkle-agentserver
# Max chars of gen_ai.input.messages / tool.definitions / output.messages /
# tool.arguments / tool.result captured per span. Default 0 = no truncation
# (full capture, so traces show complete input/output). Set a positive int
# (e.g. 4096) to cap and bound span/export size.
# TWINKLE_OBS_ATTR_LIMIT=0

# --- web_search tool ---
# Without a key, web_search falls back to DuckDuckGo HTML scraping, which is
# fragile under DDG anti-bot rate-limiting. Set a Tavily key for a reliable,
# LLM-ready primary path (free tier: https://tavily.com). Empty = DDG fallback.
# TAVILY_API_KEY=

# --- skills remote (SkillNet 一键安装) ---
# 可选 GitHub token,提升匿名 60/小时限流额度。留空=匿名。
TWINKLE_GITHUB_TOKEN=
